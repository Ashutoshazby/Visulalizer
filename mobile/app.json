{
  "expo": {
    "name": "Saanjh Music",
    "slug": "saanjh-music",
    "version": "3.0.1",
    "orientation": "portrait",
    "icon": "./assets/saanjh-logo.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      "./plugins/withBackToBackground",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030303",
          "image": "./assets/saanjh-logo.png",
          "imageWidth": 92,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#030303",
            "image": "./assets/saanjh-logo.png"
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ashutosh.nightdriveradio",
      "versionCode": 15,
      "adaptiveIcon": {
        "backgroundColor": "#07324B",
        "foregroundImage": "./assets/saanjh-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
