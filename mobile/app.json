{
  "expo": {
    "name": "Saanjh Music",
    "slug": "saanjh-music",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/saanjh-logo.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ashutosh.nightdriveradio",
      "versionCode": 8,
      "adaptiveIcon": {
        "backgroundColor": "#07324B",
        "foregroundImage": "./assets/saanjh-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
